{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "paths": {
      "#/*": ["../src/*"],
      "#docgen/*": ["../docgen/*"],
      "#scripts/*": ["../scripts/*"],
      "react-print-pdf": ["../src/index.ts"]
    },
    "types": ["node"]
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../vitest.config.ts",
    "../src/raw.d.ts"
  ]
}
