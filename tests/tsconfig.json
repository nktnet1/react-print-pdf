{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "paths": {
      "#/*": ["../src/*"],
      "#docgen/*": ["../docgen/*"],
      "#scripts/*": ["../scripts/*"],
      "react-print-pdf": ["../src/index.ts"],
      "react-print-pdf/client": ["../src/client.ts"],
      "react-print-pdf/playwright": ["../src/playwright/index.ts"],
      "#config/*": ["../config/*"],
      "react-print-pdf/mdx": ["../src/mdx.ts"]
    },
    "types": ["node"]
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../vitest.config.ts",
    "../config/vitest.node.config.ts",
    "../config/vitest.browser.config.ts",
    "../config/vitest.package.config.ts",
    "../src/raw.d.ts"
  ]
}
