{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "lib": ["dom", "esnext"],
    "allowJs": true,
    "jsx": "react-jsx",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "#/*": ["./src/*"],
      "#docgen/*": ["./docgen/*"],
      "#scripts/*": ["./scripts/*"],
      "#config/*": ["./config/*"]
    }
  },
  "include": ["src"]
}
