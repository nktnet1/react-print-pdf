{
  "name": "react-print-pdf",
  "version": "0.1.151-beta.1",
  "type": "module",
  "description": "Open-source React components and utilities for building printable PDF documents",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      },
      "require": {
        "types": "./dist/client/index.d.cts",
        "default": "./dist/client/index.cjs"
      }
    },
    "./playwright": {
      "import": {
        "types": "./dist/playwright/index.d.ts",
        "default": "./dist/playwright/index.js"
      },
      "require": {
        "types": "./dist/playwright/index.d.cts",
        "default": "./dist/playwright/index.cjs"
      }
    },
    "./mdx": {
      "import": {
        "types": "./dist/mdx.d.ts",
        "default": "./dist/mdx.js"
      },
      "require": {
        "types": "./dist/mdx.d.cts",
        "default": "./dist/mdx.cjs"
      }
    },
    "./dist/*.css": {
      "import": "./dist/*.css",
      "require": "./dist/*.css"
    }
  },
  "scripts": {
    "build": "tsdown --config config/tsdown.config.ts --config-loader tsx",
    "test": "pnpm test:source && pnpm test:package",
    "test:source": "vitest run",
    "test:docgen": "vitest run --config config/vitest.node.config.ts tests/docgen tests/tailwind/tailwind-collector.node.test.tsx",
    "test:package": "pnpm build && vitest run --config config/vitest.package.config.ts",
    "test:coverage": "vitest run --coverage && tsx scripts/check-source-coverage.ts coverage/combined/coverage-summary.json && pnpm test:package",
    "dev": "pnpm --dir ./docs dev",
    "build-components": "npm run build && node --import ./scripts/register-docgen-typescript.mjs --import tsx ./docgen/index.ts",
    "prune-docs": "tsx ./docgen/prune.ts",
    "build-components-commit": "npm run build-components && npm run prune-docs",
    "lint": "biome lint",
    "format": "biome format",
    "check": "biome check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p docgen/tsconfig.json && tsc --noEmit -p tests/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p config/tsconfig.tools.json",
    "docs:build": "pnpm --dir ./docs build",
    "test:watch": "vitest --config config/vitest.browser.config.ts --browser.headless=false",
    "release:beta": "tsx ./scripts/release-beta.ts",
    "bootstrap:package": "tsx ./scripts/bootstrap-package.ts",
    "setup:oidc": "tsx ./scripts/setup-oidc.ts",
    "release:validate": "tsx ./scripts/validate-release.ts",
    "prepublishOnly": "tsx ./scripts/prevent-direct-publish.ts",
    "test:verdaccio": "pnpm build && tsx ./scripts/test-verdaccio.ts",
    "test:verdaccio:smoke": "pnpm build && tsx ./scripts/test-verdaccio.ts --smoke",
    "test:gotenberg": "pnpm build && node ./tests/gotenberg/gotenberg.integration.mjs"
  },
  "pre-commit": [
    "check"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@chakra-ui/react": "^3.37.0",
    "@heroicons/react": "^2.2.0",
    "@mdx-js/rollup": "^3.1.1",
    "@rolldown/plugin-node-polyfills": "^1.0.3",
    "@tsdown/css": "^0.23.0",
    "@typescript/typescript6": "^6.0.2",
    "@types/node": "^26.6.4",
    "@types/postcss-css-variables": "^0.18.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "front-matter": "^4.0.2",
    "glob": "^13.0.6",
    "lefthook": "^2.2.0",
    "playwright": "^1.64.0",
    "postcss": "^8.5.29",
    "postcss-color-functional-notation": "^8.0.15",
    "postcss-css-variables": "^0.19.0",
    "postcss-logical": "^9.0.2",
    "pre-commit": "^2.0.0",
    "prettier": "^3.9.9",
    "qrcode.react": "^4.2.0",
    "react-docgen-typescript": "^2.4.0",
    "recharts": "^3.10.1",
    "remark-frontmatter": "^5.0.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "unplugin-raw": "^0.8.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@csstools/postcss-is-pseudo-class": "^6.0.3",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "html-entities": "^2.6.0",
    "katex": "^0.19.0",
    "markdown-to-jsx": "^9.10.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "4.3.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.64.2"
  },
  "packageManager": "pnpm@12.10.1",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nktnet1/react-print-pdf.git"
  },
  "imports": {
    "#/*": "./src/*",
    "#docgen/*": "./docgen/*",
    "#scripts/*": "./scripts/*",
    "#config/*": "./config/*.ts"
  },
  "peerDependencies": {
    "playwright": ">=1.42.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  }
}
