{
  "name": "react-print-pdf",
  "version": "0.1.150",
  "description": "Fileforge components for JavaScript React",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "require": "./dist/client/index.js",
      "import": "./dist/client/index.mjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "require": "./dist/server/index.js",
      "import": "./dist/server/index.mjs"
    },
    "./mdx": {
      "types": "./dist/mdx.d.ts",
      "require": "./dist/mdx.js",
      "import": "./dist/mdx.mjs"
    },
    "./dist/*.css": {
      "import": "./dist/*.css",
      "require": "./dist/*.css"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "playwright install chromium && npm run build && vitest run",
    "dev": "pnpm --dir ./docs dev",
    "build-components": "npm run build && tsx ./docgen/index.ts",
    "prune-docs": "tsx ./docgen/prune.ts",
    "build-components-commit": "npm run build-components && npm run prune-docs",
    "lint": "biome lint",
    "format": "biome format",
    "check": "biome check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p docgen/tsconfig.json && tsc --noEmit -p tests/tsconfig.json && tsc --noEmit -p tsconfig.tools.json",
    "docs:build": "pnpm --dir ./docs build",
    "test:watch": "playwright install chromium && npm run build && vitest --browser.headless=false",
    "release:beta": "tsx ./scripts/release-beta.ts",
    "release:validate": "tsx ./scripts/validate-release.ts",
    "prepublishOnly": "tsx ./scripts/prevent-direct-publish.ts"
  },
  "pre-commit": [
    "build-components-commit"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@chakra-ui/react": "^2.10.10",
    "@fileforge/client": "^0.1.18",
    "@heroicons/react": "^2.2.0",
    "@mdx-js/rollup": "^3.1.1",
    "@rolldown/plugin-node-polyfills": "^1.0.3",
    "@tsdown/css": "^0.23.0",
    "@types/node": "^25.9.9",
    "@types/postcss-css-variables": "^0.18.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitest/browser-playwright": "^4.1.11",
    "dotenv": "^18.0.6",
    "front-matter": "^4.0.2",
    "glob": "^13.0.6",
    "pdf2pic": "^3.2.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.29",
    "postcss-color-functional-notation": "^8.0.15",
    "postcss-css-variables": "^0.19.0",
    "postcss-logical": "^7.0.1",
    "pre-commit": "^1.2.2",
    "prettier": "^3.9.9",
    "qrcode.react": "^3.2.0",
    "react-docgen-typescript": "^2.4.0",
    "recharts": "^2.15.4",
    "remark-frontmatter": "^5.0.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "unplugin-raw": "^0.7.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@csstools/postcss-is-pseudo-class": "^6.0.3",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "html-entities": "^2.6.0",
    "katex": "^0.19.0",
    "markdown-to-jsx": "^7.7.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "4.3.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.64.0"
  },
  "packageManager": "pnpm@12.10.1",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ]
}
